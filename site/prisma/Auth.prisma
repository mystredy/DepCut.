model User {
  id            String    @id
  // The name Google gave us at sign-in. Never edited in the product.
  name          String
  // The name the product shows instead, when the user has set one.
  displayName   String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  superUser     Boolean   @default(false)
  // Stripe customer id, one per user, shared across every billing product
  // (Pro, Vision, one-time credit top-ups) so a customer is never duplicated.
  stripeCustomerId String? @unique
  // Set by the Preferences page's "Link bot" flow once the webhook redeems a
  // TelegramLinkToken for this account. telegramUsername is display-only.
  telegramChatId   String? @unique
  telegramUsername String?
  // Pending confirmation for unlinking Telegram: set when "Unlink" sends a
  // code to the linked chat, cleared once redeemed or overwritten by a
  // fresh unlink request. Confirms the unlink came from whoever controls
  // the linked Telegram chat, not just whoever's signed into the browser.
  telegramUnlinkCode          String?
  telegramUnlinkCodeExpiresAt DateTime?
  telegramLinkTokens TelegramLinkToken[]
  notificationPreferences UserNotificationPreferences?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  creditAccount UserCreditAccount?
  creditGrants  UserCreditGrant[]
  creditLedgerEntries UserCreditLedgerEntry[]
  inferenceUsageEvents InferenceUsageEvent[]
  creditLimits UserCreditLimit[]
  creditAutoReload CreditAutoReload?
  apiKeys       Apikey[]
  visionApiSubscription VisionApiSubscription?
  proSubscription ProSubscription?
  avatar        UserAvatar?
  onboarding    UserOnboarding?
  emailSettings UserEmailSettings?
  claimedTasks  Task[] @relation("TaskClaims")
  submissions   Submission[] @relation("UserSubmissions")
  workspaceLinks UserWorkspaceLink[]
  drops         Drop[]
  reviewedSubmissions Submission[] @relation("ReviewedSubmissions")
  uploadsCreated Upload[] @relation("UploadCreatedBy")
  uploadsToPublish Upload[] @relation("UploadPublishBy")
  notifications Notification[]
  supportTicketsRaised   SupportTicket[] @relation("SupportTicketRaisedBy")
  supportMessagesSent    SupportMessage[] @relation("SupportMessageAuthor")
  artistRateAccount ArtistRateAccount?
  payoutAccount PayoutAccount?
  withdrawals   Withdrawal[]
  financeTransactions FinanceTransaction[]
  giveawayPayments GiveawayPayment[]
  referralCommission ReferralCommission?
  creatorApplication CreatorApplication?
  affiliate          Affiliate?
  affiliateReferral  AffiliateReferral? @relation("AffiliateReferredUser")
  socialConnections  SocialConnection[]
  ownedStudios      Studio[]         @relation("StudioOwner")
  studioMemberships StudioMember[]
  studioInvitesSent StudioInvite[]   @relation("StudioInvitesSent")
  studioActivity    StudioActivity[]
  blogPostsCreated  BlogPost[]       @relation("BlogPostCreatedBy")
  studioAssignments        ArtistStudioAssignment[]
  studioAssignmentsGranted ArtistStudioAssignment[] @relation("StudioAssignmentsGranted")
  editCodes                SubmissionEditCode[]

  @@map("user")
}

// The picture the user uploaded, already cropped and compressed by the client.
// Kept out of `user` so the row every session read touches stays small.
model UserAvatar {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data        Bytes
  contentType String
  updatedAt   DateTime @updatedAt
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
