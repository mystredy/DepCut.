// Creator marketplace: the shared category taxonomy, the Inspire-mode task
// board, and Submit Project's submissions. Status/type fields are plain
// String (not Prisma enum) to match this schema's existing convention — see
// Credits.prisma's UserCreditGrant.status for the same pattern; the closed
// unions live in the TypeScript types that read/write these columns.

// The single source for the marketplace's category list. Both Submit
// Project's category picker and the Inspiration board read from this table
// instead of each keeping their own hardcoded array; /api/categories
// self-seeds it from src/lib/marketplace/categories-seed.ts on first read.
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  emoji       String
  // Comma-separated example niches under this category, e.g. "Celebrity
  // news, pop culture, viral moments, ...".
  niches      String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
  submissions Submission[]

  @@map("category")
}

// An Inspire-mode task on the creator marketplace: a brief a creator can
// claim and submit a remix against. status: "available" | "taken" |
// "submitted" | "under_review" | "completed" | "expired".
model Task {
  id                      String    @id @default(cuid())
  title                   String
  categoryId              String
  category                Category  @relation(fields: [categoryId], references: [id])
  maxRates                Int
  description             String
  status                  String    @default("available")
  deadline                DateTime
  requiredArtists         String[]  @default([])
  script                  String?
  shortClip               String?
  fullClip                String?
  instructions            String?
  hoursToComplete         Int?
  additionalRevenueReward Boolean   @default(false)
  niche                   String?
  claimedAt               DateTime?
  claimedById             String?
  claimedBy               User?     @relation("TaskClaims", fields: [claimedById], references: [id])
  expiresAt               DateTime?
  submittedAt             DateTime?
  reviewedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  submissions             Submission[]
  uploads                 Upload[]

  @@index([status])
  @@index([categoryId])
  @@map("task")
}

// A Submit Project submission. subType: "SPVID" (publisher) | "CSVID"
// (creator, the default — SPVID has no UI yet). extension: "standard" |
// "pro". subSource: "InspiredExternal" | "TaskExternal" — every submission
// through this flow comes from an external editing tool, so it's always the
// External variant, chosen by which mode (Inspire vs Task) the creator
// submitted under.
//
// status tracks the upload lifecycle, separately from reviewStatus (the
// admin review lifecycle below, which only starts once status reaches
// "submitted"): "draft" (created the instant "New Submit" is clicked, freely
// editable, nothing locked) | "submitting" (the creator asked to submit —
// submitRequestedAt records when — but at least one required asset in
// `assets` hasn't reached "complete" yet) | "submitted" (every required
// asset confirmed in R2; the only status admin's queue ever sees) | "failed"
// (a required asset never completed; the creator can retry that asset,
// which re-attempts promotion straight to "submitted" without a second
// Submit click, since submitRequestedAt is still set). See
// tryPromoteSubmission in /api/submissions for the promotion logic.
//
// reviewStatus: "Pending" | "InReview" | "Qualified" | "Disqualified".
// points: engagement/reputation/XP points, a separate currency from Rates.
// amount: direct USD value credited to pending balance on submit, moved to
// available on approval. reward: a bonus/incentive metric layered on top of
// amount for campaign-specific payout tiers.
model Submission {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation("UserSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  // Set when this submission came from the editor's Submit button, rather
  // than the manual video/thumbnail upload flow. Drives two things: the
  // submit-project UI shows the project's title instead of drop-zones, and
  // the project is locked to its owner (read-only) while this submission is
  // outstanding — see CutProject.submissions.
  projectId         String?
  project           CutProject?       @relation(fields: [projectId], references: [id])
  subSource         String?
  subType           String            @default("CSVID")
  extension         String            @default("standard")
  // Nullable: a fresh draft starts with nothing filled in.
  title             String?
  categoryId        String?
  category          Category?         @relation(fields: [categoryId], references: [id])
  status            String?
  statusRemark      String?
  points            Int?
  amount            Float?
  reward            Float?
  inspireUrl        String?
  taskId            String?
  task              Task?             @relation(fields: [taskId], references: [id])
  // The connected workspace picked for this submission — a real
  // UserWorkspaceLink id (that user's own row; see the PATCH route's
  // ownership check), not the bare provider key.
  spaceid           String?
  workspace         UserWorkspaceLink? @relation(fields: [spaceid], references: [id], onDelete: SetNull)
  voiceScript       String?
  duration          Int?
  publishingid      String?
  editCode          String?
  // The studio this Pro submission is for — set once an edit code or a
  // matching YouTube link is verified. See ProSubmissionCodes.prisma and
  // /api/submissions/[id]/edit-code.
  studioId          String?
  studio            Studio?           @relation(fields: [studioId], references: [id], onDelete: SetNull)
  editCodeRedemptions SubmissionEditCode[]
  watermarkEnabled  Boolean           @default(false)
  watermarkText     String?
  burnInCaptions    Boolean           @default(false)
  generatedMetadata Boolean           @default(false)
  // Pro Verification Suite scratch fields — the creator edits these while
  // drafting; at promotion to "submitted" they're copied onto the real
  // publishing-package Upload row (see tryPromoteSubmission), which is what
  // admin/uploads and the publish pipeline actually read.
  packageTitle       String?
  packageDescription String?
  packageTags        String?
  maxRates          Int?
  earnedRates       Int?
  reviewScore       Int?
  additionalReward  Float?
  publisherWorkdone Int?
  creatorWorkdone   Int?
  reviewedById      String?
  reviewedByUser    User?             @relation("ReviewedSubmissions", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  reviewRemark      String?
  reviewStatus      String?
  reviewedByName    String?
  reviewStartedAt   DateTime?
  reviewCompletedAt DateTime?
  createdAt         DateTime          @default(now())
  // The creator clicked Submit — set once, never cleared, even across a
  // failed → retried → submitted cycle. Distinguishes an abandoned draft
  // from one the creator actually tried to send.
  submitRequestedAt DateTime?
  // Set only once every required asset lands — i.e. on promotion to
  // "submitted", not at creation.
  submittedAt       DateTime?
  updatedAt         DateTime          @updatedAt
  uploads           Upload[]
  assets            SubmissionAsset[]

  @@index([userId, createdAt])
  @@index([taskId])
  @@index([categoryId])
  @@index([reviewStatus])
  @@index([status])
  @@index([projectId])
  @@index([studioId])
  @@map("submission")
}

// One row per uploaded asset on a submission — video, thumbnail, or the Pro
// verification export. type: "video" | "thumbnail" | "verification".
// status: "pending" (row exists, presigned, nothing uploaded yet) |
// "uploading" | "complete" (head()-verified in R2) | "failed". Decoupled
// from Submission.status on purpose: an asset can still be "uploading" while
// the submission itself has already moved to "submitting" — that's the
// whole point of letting Submit fire before uploads finish. Re-picking a
// file upserts the same row by (submissionId, type) rather than creating a
// second one.
model SubmissionAsset {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  type         String
  // Original picked filename, kept as a label.
  fileName     String?
  // R2 object key — see src/cut/server/cloud/r2.ts's submissionVideoKey /
  // submissionThumbnailKey / submissionVerificationKey. Set as soon as a PUT
  // is presigned; status is what tracks whether the bytes actually arrived.
  storageKey   String?
  status       String     @default("pending")
  error        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([submissionId, type])
  @@index([submissionId])
  @@index([status])
  @@map("submission_asset")
}

// A creator's linked external editing workspace — the Submit Project page's
// Collaboration Hub (submit-project/[id]/page.tsx). Owned by the user, not a
// single submission: connect once and every submission's workspace picker
// (Submission.spaceid) can select it, rather than reconnecting per
// submission. provider is one of that page's fixed integration ids (capcut,
// canva, veed, premiere, davinci, finalcut, frameio, postlab, lucidlink) —
// kept as free text rather than an enum so the page can add a new one
// without a migration. No password field on purpose: the Connect Workspace
// dialog never asks for one — storing a real third-party service password
// here would mean holding a credential this app has no business keeping.
// Real access to a linked workspace belongs behind OAuth, not a form field.
model UserWorkspaceLink {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String
  workspaceName String
  editorEmail   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  submissions   Submission[]

  @@unique([userId, provider])
  @@index([userId])
  @@map("user_workspace_link")
}

// The Pro Verification Suite's publishing package for a submission: the
// AI-generated title/description/tags/media, and (once a publisher pushes it
// out) per-platform links and verification. Submission.publishingid holds
// this row's id once one exists. status: "Pending" | "Processing" |
// "Published" | "Failed".
model Upload {
  id                  String    @id @default(cuid())
  createdById         String?
  createdBy           User?     @relation("UploadCreatedBy", fields: [createdById], references: [id])
  publishById         String?
  publishBy           User?     @relation("UploadPublishBy", fields: [publishById], references: [id])
  taskId              String?
  task                Task?     @relation(fields: [taskId], references: [id])
  submissionId        String?
  submission          Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  // Comma-separated tags.
  tags                String?
  mediaUrls           String?
  // Pro submissions' fresh export from the editor, matched against the main
  // submission video to verify it's the final cut. mediaFile is the original
  // picked filename; mediaKey is the real R2 object key once uploaded — see
  // submissionVerificationKey and
  // /api/submissions/[id]/verification/{presign,complete}.
  mediaFile           String?
  mediaKey            String?
  status              String    @default("Pending")
  brandName           String?
  date                DateTime?
  postType            String?
  publishedPostIds    String[]  @default([])
  // { passed: boolean, checkedAt: string, errors?: string[] }
  publishVerification Json?
  // { youtube?, facebook?, instagram?, tiktok?, threads?, snapchat?, x? } or a plain string
  publishLink         Json?
  publishedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  posts               Post[]

  @@index([submissionId])
  @@index([taskId])
  @@index([status])
  @@map("upload")
}

// One per-platform post an Upload fans out to (an Upload with a YouTube and a
// TikTok link publishes as two Post rows). platform: "tiktok" | "youtube" |
// "facebook" | "instagram" | "threads" | "snapchat" | "x". state flattens the
// PostState union: "scheduled" | "published" (→ postUrl) | "failed"
// (→ errorMessage) — only the matching column is set for a given state.
//
// No publish integration exists yet (no per-platform API keys/OAuth) — this
// is schema only, ready for whenever that pipeline gets built.
model Post {
  id           String    @id @default(cuid())
  uploadId     String
  upload       Upload    @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  postTime     DateTime?
  platform     String?
  shortLink    Boolean   @default(false)
  text         String?
  mediaUrls    String?
  state        String    @default("scheduled")
  postUrl      String?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([uploadId])
  @@index([state])
  @@map("post")
}

// Site-wide payout rail configuration: which providers are enabled and their
// credentials. Self-seeds one disabled row per provider on first read (see
// /api/admin/payment-methods) — provider: "cryptomus" | "paypal" | "wise" |
// "flutterwave" | "paystack". Secret fields are write-only from the admin
// API: reads return whether each is set, never the value itself.
model PaymentMethod {
  id            String   @id @default(cuid())
  provider      String   @unique
  enabled       Boolean  @default(false)
  publicKey     String?
  // The provider's pay-in credential (receiving payments). For Cryptomus
  // specifically this is the Payment API Key, distinct from payoutKey below
  // — see PAYMENT_METHOD_ENV_VARS in payment-methods-seed.ts for which env
  // var each field mirrors, per provider.
  secretKey     String?
  // The provider's pay-out credential (sending payouts to creators), where
  // the provider issues a separate key for that — Cryptomus does; null for
  // providers that use the same key for both.
  payoutKey     String?
  merchantId    String?
  webhookSecret String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("payment_method")
}
